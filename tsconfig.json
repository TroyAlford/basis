{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "basis/*": [
        "./consumer/*.ts"
      ],
      "basis/react/icons": [
        "./consumer/react-icons.ts"
      ],
      "basis/testing/bun": [
        "./consumer/testing-bun.ts"
      ]
    },
    "rootDir": ".",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": [
      "bun-types",
      "./libraries/react/testing/bun/globals"
    ]
  },
  "exclude": [
    ".cache",
    "build",
    "dist",
    "node_modules"
  ]
}
