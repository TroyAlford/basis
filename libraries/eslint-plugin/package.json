{
  "main": "./index.mjs",
  "module": "./index.mjs",
  "name": "@basis/eslint-plugin",
  "description": "A comprehensive ESLint plugin for enforcing coding standards and best practices.",
  "type": "module",
  "engines": {
    "bun": "*"
  },
  "scripts": {
    "build": "bun build:tsc && bun build:fix-extensions",
    "build:tsc": "bun ../../node_modules/@typescript/native/bin/tsc ./index.ts --ignoreConfig --allowSyntheticDefaultImports --esModuleInterop --module ESNext --moduleResolution bundler --outDir ./dist --skipLibCheck --strict false --types bun-types",
    "build:fix-extensions": "bun scripts/fix-extensions.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.70.0"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
