{
  "license": "MIT",
  "name": "basis",
  "private": true,
  "version": "1.0.0",
  "bin": {
    "basis": "./consumer/cli.ts"
  },
  "exports": {
    "./cli": "./consumer/cli.ts",
    "./configuration": "./consumer/configuration.ts",
    "./eslint": "./consumer/eslint.ts",
    "./eslint.config.mjs": "./eslint.config.mjs",
    "./logger": "./consumer/logger.ts",
    "./markdown": "./consumer/markdown.ts",
    "./oauth": "./consumer/oauth.ts",
    "./package.json": "./package.json",
    "./react": "./consumer/react.ts",
    "./react/icons": "./consumer/react-icons.ts",
    "./review": "./consumer/review.ts",
    "./serve": "./consumer/serve.ts",
    "./server": "./consumer/server.ts",
    "./stylelint": "./consumer/stylelint.ts",
    "./testing": "./consumer/testing.ts",
    "./testing/bun": "./consumer/testing-bun.ts",
    "./tsconfig/base.json": "./consumer/tsconfig/base.json",
    "./tsconfig/bun.json": "./consumer/tsconfig/bun.json",
    "./tsconfig/react.json": "./consumer/tsconfig/react.json"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "@types/estree": "1.0.8"
  },
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@floating-ui/dom": "^1.7.6",
    "@happy-dom/global-registrator": "^20.14.5",
    "@mdx-js/mdx": "^3.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/utils": "^8.70.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "beautiful-mermaid": "^1.1.3",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-perfectionist": "^5.11.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "less": "^4.6.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "postcss-styled-syntax": "^0.7.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-refresh": "^0.18.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-consecutive-blank-lines": "^5.0.1",
    "remark-lint-ordered-list-marker-value": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sass": "1.98.0",
    "shiki": "3.0.0",
    "stylelint": "^17.15.0",
    "stylelint-order": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "unified": "^11.0.5",
    "unified-lint-rule": "^3.0.1",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/estree": "1.0.8",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "bun-types": "^1.4.2",
    "husky": "^9.1.7",
    "svg-path-commander": "^2.3.3"
  },
  "scripts": {
    "start": "bun ./server.ts",
    "build": "bun run --filter='*' build",
    "bench:impact": "bun ./scripts/benchmark-impact.ts",
    "bench:snapshot": "bun ./scripts/benchmark-snapshot-image.ts",
    "ci:contract": "bun test ./.github/ci",
    "ci:verify": "bun ./scripts/verify-ci.ts",
    "docs": "bun run start",
    "docs:build": "bun ./libraries/docs/build.ts --title Basis",
    "docs:check": "bun ./consumer/cli.ts docs check",
    "format": "bun ./consumer/cli.ts format",
    "lint": "bun run lint:es && bun run lint:ts && bun run lint:css && bun run lint:md",
    "lint:css": "bun ./node_modules/stylelint/bin/stylelint.mjs \"**/*.styles.ts\" --config ./stylelint.config.mjs --allow-empty-input",
    "lint:es": "bun run update:linter && bun ./node_modules/eslint/bin/eslint.js .",
    "lint:md": "bun ./libraries/markdown-plugin/bin.ts",
    "lint:ts": "bun ./node_modules/@typescript/native/bin/tsc --noEmit",
    "postinstall": "bun ./consumer/install.ts",
    "prepare": "bun ./scripts/prepare.ts",
    "test": "bun run test:unit",
    "test:unit": "files=$(find ./libraries ./testing ./consumer ./packages ./.github -type f \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -not -path '*/node_modules/*' ! -path './consumer/cli.test.ts' ! -path './libraries/server/source/Server.test.ts' ! -path './libraries/testing/application.lifecycle.test.ts' ! -path './libraries/testing/lanes.test.ts' ! -path './.github/ci/*' ! -path './libraries/react/components/*' ! -path './libraries/react/icons/*'); if [ -n \"$files\" ]; then bun test $files; fi",
    "test:coverage": "bun run test:unit --coverage",
    "test:component": "files=$(find ./libraries/react/components ./libraries/react/icons -type f -name '*.test.tsx'); if [ -n \"$files\" ]; then bun test $files; fi",
    "test:contract": "bun test ./consumer/cli.test.ts ./.github/ci ./libraries/testing/lanes.test.ts",
    "test:server": "bun test ./libraries/server/source/Server.test.ts",
    "test:lifecycle": "bun test ./libraries/testing/application.lifecycle.test.ts",
    "test:screenshots": "files=$(find ./libraries -type f \\( -name '*.screenshot.tsx' -o -name '*.screenshot.ts' \\) -not -path '*/node_modules/*'); if [ -n \"$files\" ]; then bun test $files; fi",
    "test:e2e": "files=$(find ./libraries -type f \\( -name '*.e2e.ts' -o -name '*.e2e.tsx' \\) -not -path '*/node_modules/*' ! -name 'DatabaseFixture.lifecycle.e2e.ts' ! -name 'runtime.lifecycle.e2e.ts' ! -name 'docs.e2e.ts' ! -name 'visual.live.e2e.ts' ! -name 'application.hmr.e2e.ts'); if [ -n \"$files\" ]; then BASIS_E2E_FAST=1 bun test $files; fi",
    "test:e2e:visual": "bun test ./libraries/testing/docs.e2e.ts ./libraries/react/components/visual.live.e2e.ts",
    "test:e2e:database-fixtures": "bun test ./libraries/server/source/Database.e2e.ts -t \"supports independent installs\" && bun test ./libraries/server/source/Database.e2e.ts -t \"queries prebuilt polymorphic\"",
    "test:e2e:hmr": "bun test ./libraries/testing/application.hmr.e2e.ts",
    "test:e2e:fixtures": "bun run test:e2e:database-fixtures && bun test ./libraries/server/source/DatabaseFixture.lifecycle.e2e.ts ./libraries/testing/runtime.lifecycle.e2e.ts && bun run test:e2e:hmr",
    "test:e2e:all": "bun run test:e2e && bun run test:e2e:visual && bun run test:e2e:fixtures",
    "test:all": "bun run test:unit && bun run test:component && bun run test:contract && bun run test:server && bun run test:lifecycle && bun run test:screenshots && bun run test:e2e:all",
    "test:consumer": "bun ./consumer/test/self-install.ts && bun ./consumer/test/cache-isolation.ts && bun ./consumer/test/react-runtime.ts",
    "test:develop": "bun test --watch",
    "up": "bunx npm-check-updates -p bun --enginesNode --upgrade --root --workspaces",
    "update:linter": "bun --filter=@basis/eslint-plugin run build",
    "workspace": "bun ./libraries/workspaces/source/bin/workspace.ts",
    "ws": "bun workspace"
  },
  "type": "module",
  "workspaces": [
    "libraries/*",
    "testing/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@basis/workspaces"
  ]
}
