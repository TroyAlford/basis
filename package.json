{
  "license": "MIT",
  "name": "basis",
  "private": true,
  "version": "1.0.0",
  "bin": {
    "basis": "./consumer/cli.ts"
  },
  "exports": {
    "./cli": "./consumer/cli.ts",
    "./eslint": "./consumer/eslint.ts",
    "./eslint.config.mjs": "./eslint.config.mjs",
    "./package.json": "./package.json",
    "./tsconfig/base.json": "./consumer/tsconfig/base.json",
    "./tsconfig/bun.json": "./consumer/tsconfig/bun.json",
    "./tsconfig/react.json": "./consumer/tsconfig/react.json"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@typescript-eslint/utils": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-newlines": "^2.0.0",
    "eslint-plugin-import-order-alphabetical": "^1.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-named-import-spacing": "1.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-typescript-sort-keys": "3.3.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.8.9",
    "@types/bun": "^1.3.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.11",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "svg-path-commander": "^2.1.11"
  },
  "scripts": {
    "build": "bun run --filter='*' build",
    "docs": "bun ./libraries/docs/index.html",
    "lint": "bun run lint:es && bun run lint:ts",
    "lint:es": "bun run update:linter && bun eslint .",
    "lint:ts": "bun tsc --noEmit",
    "postinstall": "bun ./consumer/install.ts",
    "prepare": "bun ./scripts/prepare.ts",
    "test:consumer": "bun ./consumer/test/self-install.ts",
    "test:develop": "bun test --watch",
    "up": "bunx npm-check-updates -p bun --enginesNode --upgrade --root --workspaces",
    "update:linter": "bun --filter=@basis/eslint-plugin run build",
    "workspace": "bun ./libraries/workspaces/source/bin/workspace.ts",
    "ws": "bun workspace"
  },
  "type": "module",
  "workspaces": [
    "libraries/*",
    "testing/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@basis/workspaces"
  ],
  "patchedDependencies": {
    "eslint-plugin-import@2.32.0": "patches/eslint-plugin-import@2.32.0.patch",
    "eslint-plugin-named-import-spacing@1.0.3": "patches/eslint-plugin-named-import-spacing@1.0.3.patch",
    "eslint-plugin-sort-keys-fix@1.1.2": "patches/eslint-plugin-sort-keys-fix@1.1.2.patch",
    "eslint-plugin-typescript-sort-keys@3.3.0": "patches/eslint-plugin-typescript-sort-keys@3.3.0.patch"
  }
}
